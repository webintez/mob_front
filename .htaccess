DirectoryIndex index.html
Options -Indexes

# Force browsers to reload CSS files (no caching)
<FilesMatch "\.(css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</FilesMatch>

# Security: Deny access to sensitive files
<FilesMatch "^(server\.js|package\.json|package-lock\.json|\.env|\.gitignore|README\.md|API_INTEGRATION\.md|ENDPOINTS_USAGE.md|LOGIN_REGISTER_DOCUMENTATION.md|TODO.md|QUICK_FIX.md|SETUP_COMPLETE\.md|apache\.conf|nginx\.conf|nginx-nodejs\.conf|install-node\.sh|keep-alive\.sh|mobitez-frontend\.service|reload-nginx\.sh|setup-server\.sh|update-nginx-config\.sh|start-server\.sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security: Deny access to hidden files (starting with a dot)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# API Proxy: Forward /api/ requests to Node.js server via PHP proxy
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^api/(.*)$ api-proxy.php?path=$1 [QSA,L]

# Image Storage Proxy: Forward /storage/ requests to local secure PHP proxy
RewriteCond %{REQUEST_URI} ^/storage/ [NC]
RewriteRule ^storage/(.*)$ storage-proxy.php?path=$1 [QSA,L]

# Cache static images and fonts for 1 year to satisfy PageSpeed recommendations
<FilesMatch "\.(jpg|jpeg|gif|png|webp|svg|ico|woff|woff2|ttf|otf)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=31536000, public, immutable"
    </IfModule>
</FilesMatch>

# Force browsers to reload JavaScript and HTML files (no caching)
<FilesMatch "\.(js|html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</FilesMatch>